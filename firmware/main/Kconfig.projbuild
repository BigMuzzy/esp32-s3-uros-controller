menu "Motor Driver"

choice MOTOR_DRIVER_BACKEND
    prompt "Motor controller backend"
    default MOTOR_DRIVER_VESC
    help
        Selects the motor-controller hardware the firmware drives.
        Exactly one backend is compiled in; the others are excluded
        from the build by CMake.  The HAL contract is defined in
        main/motor_driver.h — all upper-layer code (motor_task,
        diff_drive, uros_task) is backend-agnostic.

config MOTOR_DRIVER_VESC
    bool "VESC (2× controllers over custom CAN)"
    help
        Two VESC ESC/BLDC controllers on a shared TWAI bus at
        500 kbit/s.  Custom CAN protocol (SET_RPM / STATUS /
        STATUS_5 / PING / PONG).  Wheel velocity controlled via
        the on-board speed PID; tuning over the tune_cli CLI.

config MOTOR_DRIVER_ZLAC8015D
    bool "ZLAC8015D (1× dual-channel over CANopen)"
    help
        Single ZLAC8015D dual-channel servo drive on the TWAI bus
        speaking CANopen CiA 402 (Profile Velocity mode).  Driving
        2× ZLLG65ASM250 servo motors with 4096-line absolute
        encoders.

        Default object-dictionary assumptions are documented in
        main/motor_driver_zlac8015d.c — review against the vendor
        manual before robot bring-up.

endchoice

endmenu

menu "ZLAC8015D backend"
    depends on MOTOR_DRIVER_ZLAC8015D

config ZLAC_CAN_TX_GPIO
    int "TWAI TX GPIO"
    default 15

config ZLAC_CAN_RX_GPIO
    int "TWAI RX GPIO"
    default 16

config ZLAC_NODE_ID
    int "CANopen node ID of the drive"
    range 1 127
    default 1
    help
        ZLAC8015D is a single CANopen node with two motor
        channels (LEFT = sub-index 1, RIGHT = sub-index 2 on the
        relevant objects). Default factory ID is 1; change via
        object 0x200A if you have multiple drives on one bus.

config ZLAC_ENCODER_COUNTS_PER_REV
    int "Encoder counts per motor revolution"
    default 4096
    help
        Counts reported by object 0x6064 per motor shaft
        revolution.  Equal to (drive PPR setting in 0x200E) × 4
        after the drive's internal quadrature decoding.  Default
        factory PPR is 1024 → 4096 counts/rev.  If you reprogram
        0x200E to 4096 (matching a 4096-line encoder) set this
        to 16384.

config ZLAC_GEAR_RATIO_X100
    int "Gear ratio × 100 (e.g. 200 = 2.00:1)"
    default 100
    help
        Mechanical reduction between motor shaft and wheel.  Used
        for both velocity (wheel_rpm = motor_rpm / ratio) and
        position (wheel_revs = counts / (cpr × ratio)).

config ZLAC_INVERT_LEFT
    bool "Invert LEFT axis direction"
    default n

config ZLAC_INVERT_RIGHT
    bool "Invert RIGHT axis direction"
    default n

config ZLAC_PROFILE_ACCEL_MS
    int "S-curve acceleration time (ms, object 0x6083)"
    range 0 32767
    default 500
    help
        Time to accelerate from 0 to target speed.  Vendor unit
        is milliseconds (NOT RPM/s).

config ZLAC_PROFILE_DECEL_MS
    int "S-curve deceleration time (ms, object 0x6084)"
    range 0 32767
    default 500

config ZLAC_HEARTBEAT_INTERVAL_MS
    int "Producer heartbeat interval (ms, object 0x1017)"
    range 20 2000
    default 100
    help
        Drive sends a heartbeat frame on 0x700+node at this
        cadence.  Underlying register unit is 0.5 ms; firmware
        converts.  Set 0 in 0x1017 means disabled, so we always
        write a non-zero value during bring-up.

config ZLAC_TPDO_EVENT_MS
    int "TPDO event-timer interval (ms, object 0x18xx:5)"
    range 5 200
    default 20
    help
        Drive transmits each TPDO at this cadence (timer-trigger,
        transmission type 0xFF).  Underlying register unit is
        0.5 ms; firmware converts.

endmenu

menu "Tuning CLI (VESC PID)"
    depends on MOTOR_DRIVER_VESC

config TUNE_WIFI_ENABLE
    bool "Enable WiFi TCP transport"
    default n
    help
        When enabled, tune_cli prefers a TCP server over WiFi STA
        instead of UART0. UART0 remains the fallback if WiFi fails
        to start. The CLI line protocol is identical on both
        transports.

config TUNE_WIFI_SSID
    string "WiFi SSID"
    default ""
    depends on TUNE_WIFI_ENABLE

config TUNE_WIFI_PASSWORD
    string "WiFi password (WPA2 PSK; empty = open)"
    default ""
    depends on TUNE_WIFI_ENABLE

config TUNE_WIFI_PORT
    int "TCP port for the tuning CLI"
    range 1 65535
    default 3334
    depends on TUNE_WIFI_ENABLE

endmenu
